    {
      "name": "04 Login and changes",
      "description": "Needs the demo username and password from the API documentation (see README).",
      "item": [
        {
          "name": "A-001: Wrong credentials are refused with 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
