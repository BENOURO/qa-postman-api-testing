{
  "info": {
    "name": "Restful-Booker API tests",
    "description": "Manual-style API test cases for the Restful-Booker practice API (https://restful-booker.herokuapp.com), automated with Postman tests. See README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://restful-booker.herokuapp.com"
    },
    {
      "key": "existingId",
      "value": "1"
    },
    {
      "key": "createdId",
      "value": "1"
    },
    {
      "key": "uniqueName",
      "value": "Qa"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Read bookings",
      "description": "No login needed.",
      "item": [
        {
          "name": "R-001: Health check answers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ping"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 (documented behavior of this API)', () => pm.response.to.have.status(201));",
                  "pm.test('Body says Created', () => pm.expect(pm.response.text()).to.eql('Created'));",
                  "pm.test('Responds in under 3000 ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
        {
          "name": "R-002: List bookings returns an array of ids",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/booking"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Body is a non-empty array', () => { pm.expect(list).to.be.an('array'); pm.expect(list.length).to.be.above(0); });",
                  "pm.test('Every item has a numeric bookingid', () => list.forEach((b) => pm.expect(b.bookingid).to.be.a('number')));",
                  "pm.collectionVariables.set('existingId', list[0].bookingid);",
                  "pm.test('Responds in under 3000 ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
        {
          "name": "R-003: Get one booking: fields and types",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/booking/{{existingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Has the documented fields', () => pm.expect(b).to.have.all.keys('firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates', 'additionalneeds'));",
                  "pm.test('Field types are correct', () => { pm.expect(b.firstname).to.be.a('string'); pm.expect(b.lastname).to.be.a('string'); pm.expect(b.totalprice).to.be.a('number'); pm.expect(b.depositpaid).to.be.a('boolean'); });",
                  "pm.test('Dates look like YYYY-MM-DD', () => { pm.expect(b.bookingdates.checkin).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); pm.expect(b.bookingdates.checkout).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); });",
                  "pm.test('Content type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
                ]
              }
            }
          ]
        },
        {
          "name": "R-004: A booking that does not exist returns 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/booking/99999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "R-005: A non-numeric id is a client error, not a server error",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/booking/abc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 4xx (not 5xx)', () => pm.expect(pm.response.code).to.be.within(400, 499));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Create and search",
      "description": "No login needed. Creates bookings with a unique name.",
      "item": [
        {
          "name": "C-001: Create a valid booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/booking",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{uniqueName}}\",\n  \"lastname\": \"Tester\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2030-01-10\",\n    \"checkout\": \"2030-01-15\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('uniqueName', 'Qa' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 (documented behavior of this API)', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Returns a numeric bookingid', () => pm.expect(r.bookingid).to.be.a('number'));",
                  "pm.test('The booking in the response equals what was sent', () => pm.expect(r.booking).to.eql(JSON.parse(pm.request.body.raw)));",
                  "pm.collectionVariables.set('createdId', r.bookingid);"
                ]
              }
            }
          ]
        },
        {
          "name": "C-002: The created booking can be read back",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/booking/{{createdId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Name and price match what was created', () => { pm.expect(b.firstname).to.eql(pm.collectionVariables.get('uniqueName')); pm.expect(b.totalprice).to.eql(150); pm.expect(b.depositpaid).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "C-003: Search by first name finds the created booking",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/booking?firstname={{uniqueName}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('The created booking is in the results', () => pm.expect(pm.response.json().map((b) => b.bookingid)).to.include(Number(pm.collectionVariables.get('createdId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "C-004: Search by a name nobody has returns an empty list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/booking?firstname=NoSuchPersonXyz123"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('The list is empty', () => pm.expect(pm.response.json()).to.eql([]));"
                ]
              }
            }
          ]
        },
        {
          "name": "C-005: Quotes and markup are stored as plain text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/booking",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"<script>alert('x')</script>\",\n  \"lastname\": \"Tester\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2030-01-10\",\n    \"checkout\": \"2030-01-15\"\n  },\n  \"additionalneeds\": \"Robert'); DROP TABLE bookings;--\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Not a server error', () => pm.expect(pm.response.code).to.be.below(500));",
                  "pm.test('Text is returned exactly as sent', () => { const r = pm.response.json(); pm.expect(r.booking.firstname).to.eql(\"<script>alert('x')</script>\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
